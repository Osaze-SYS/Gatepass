PORT=3000
BASE_URL=http://localhost:3000
# Long random string used to sign login tokens and ticket QR codes
APP_SECRET=change-me-to-a-long-random-string

# ---- Database ----
# Leave DATABASE_URL blank to use the built-in PostgreSQL engine (stored in ./data). Nothing to install.
# For a real PostgreSQL server (Neon, Supabase, Render, Docker...) paste its connection string:
# DATABASE_URL=postgres://user:password@host:5432/gatepass
# Set to true if your host requires SSL and the connection string does not already say so
DATABASE_SSL=false

# ---- Payments ----
# Leave blank to use the practice checkout. Use a Paystack TEST key (sk_test_...) for real test payments and refunds.
PAYSTACK_SECRET_KEY=

# ---- Platform fee ----
# Charged per paid ticket. Free tickets never carry a fee.
PLATFORM_FEE_PERCENT=5
PLATFORM_FEE_FLAT_NAIRA=0
# buyer = added on top of the ticket price, organizer = deducted from the organizer's earnings
FEE_PAYER=buyer

# Minutes an unpaid order holds its tickets
RESERVATION_MINUTES=15

# ---- Email ----
# Leave everything below blank and no emails are sent (a short note is printed instead).
#
# Option A (recommended): Brevo's web API. Free for 300 emails a day, needs no domain, and works on every host.
BREVO_API_KEY=
#
# Option B: any SMTP service (Gmail app password, Brevo SMTP...). Blocked on some free hosts, such as Render's free plan.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
#
# The sender. It must be an address you have verified with your email service.
MAIL_FROM="Gatepass <your-verified-address@example.com>"
# Check your settings with:  npm run test-email -- you@example.com

# ---- Deployment ----
# Set to 1 when running behind a proxy such as Render or Railway so rate limits see real visitor addresses.
TRUST_PROXY=
# Optional rate limit tuning (requests per window, per visitor)
# LIMIT_AUTH=10      per 15 minutes (login and sign-up)
# LIMIT_CHECKOUT=20  per 10 minutes
# LIMIT_REFUND=10    per hour
# LIMIT_UPLOAD=60    per hour
# LIMIT_API=300      per minute